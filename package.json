    "open": "node bin/cli.mjs open",
    "menubar": "node bin/cli.mjs menubar",
    "list": "node bin/cli.mjs list",
    "compile": "node bin/cli.mjs compile",
    "validate": "node bin/cli.mjs validate",
    "test": "node --test src/lib/*.test.mjs"
  },
  "engines": {
